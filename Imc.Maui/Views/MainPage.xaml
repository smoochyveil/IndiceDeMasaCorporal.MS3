<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:viewmodels="clr-namespace:Imc.Maui.ViewModels" x:DataType="viewmodels:MainViewModel"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Indice de masa corporal">

    <VerticalStackLayout
        Padding="18"
        Spacing="8">
       
        <Border>
            <VerticalStackLayout
                Padding="24">
                <Label
                    Text="proporcione el peso en kilogramos: "/>
                <Entry 
                    BackgroundColor="WhiteSmoke"
                    TextColor="Black"
                     Text="{Binding Path=Peso}"/>
                <Label
                    Text="proporcione la complexion en metros: "/>
                <Entry
                    BackgroundColor="WhiteSmoke"
                       Text="{Binding Path=Altura}"
                    TextColor="Black"/>
            </VerticalStackLayout>            
        </Border>
        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">
            <Button
                Text="calcular"
                Command="{Binding Path=CalcularCommand}"
                BackgroundColor="Green"/>
            <Button
                Text="limpiar"
                Command="{Binding Path=LimpiarCommand}"
                />

        </HorizontalStackLayout>
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="el indice de la masa corporal es: "/>
                <Label
                    Text="{Binding Path=Imc}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
                <Label
                    Text="el estado nutricional de la persona es: "/>
                <Label
                    Text="{Binding Path=EstadoNutricional}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
    
    
</ContentPage>